# ── Instance ───────────────────────────────────────────────────────────────
# Unique identifier for this instance. Lets you run multiple Leo instances
# side-by-side; also used to namespace the agent's Unix socket
# ($XDG_RUNTIME_DIR/whatsapp-leo-${INSTANCE_GUID}.sock, falling back to /tmp).
INSTANCE_GUID="xxx"

# Shared messages database. The Go bridge writes it and the Python side reads
# it; set this if you launch either from a non-standard directory.
# MESSAGES_DB_PATH=/home/PATH/store/messages.db

# Disable OpenAI Agents SDK tracing (set to 1 for local-only Ollama use).
OPENAI_AGENTS_DISABLE_TRACING=1

# Tracing is disabled in code as well, since the SDK otherwise POSTs run traces
# (message content included) to api.openai.com. Only set this to true if you
# have a real trace backend you want the runs exported to.
AGENTS_TRACING_ENABLED=false

# When true, Leo treats every inbound message as addressed to it (skips the
# @mention check). Use on numbers dedicated to Leo.
IS_DEDICATED_NUMBER=true

# Reserved for test harnesses; leave false in normal use.
IS_TEST_MODE=false


# ── Primary Ollama ─────────────────────────────────────────────────────────
# Base URL of the primary Ollama (OpenAI-compatible /v1 endpoint).
OLLAMA_BASE_URL="http://localhost:11434/v1"

# Text model used by the agent. Pick one and uncomment.
# This is the *default*: `#model set <name>` switches the live instance and
# persists the choice, which then takes precedence over this on restart.
# Run `#model reset` to drop the override and come back to these values.
MODEL_NAME="qwen3.5:35b"

# Vision model used when an inbound message contains an image.
VISION_MODEL_NAME="gemma3:27b"

# Where the `#model` override is stored.
# MODEL_OVERRIDE_PATH="$STORE_DIR/model_override.json"

# Max image dimension (px) before Leo downscales the image prior to sending
# it to the vision model. Smaller = faster + cheaper.
MAX_IMAGE_DIMENSION="1280"

# faster-whisper model for transcribing voice notes
# (tiny | base | small | medium | large-v3 | distil-medium.en | distil-small.en).
# The distil-*.en models are several times faster on CPU but English-only —
# use `medium` or larger if you send voice notes in other languages.
WHISPER_MODEL_SIZE="distil-small.en"

# Greedy decoding (1) is much faster than beam search (5) and rarely worse on
# short voice notes.
WHISPER_BEAM_SIZE="1"

# Skip silence before transcribing — usually the bulk of a rambling recording.
WHISPER_VAD_FILTER=true

# cpu | cuda | cuda:<index>. On CUDA the model holds VRAM for the life of the
# process even when no voice note arrives, which is memory Ollama wants for the
# main model — so CPU by default. Use cuda:1 to pin it to a second GPU.
WHISPER_DEVICE="cpu"

# int8 on CPU (~4x smaller than float32, no audible loss on speech).
# float16 or int8_float16 on CUDA.
WHISPER_COMPUTE_TYPE="int8"

# Load the model at startup instead of on the first voice note. Off by default:
# on CPU the load is quick, and pre-warming keeps it resident from boot.
WHISPER_PREWARM=false


# ── Backup Ollama (degraded fallback) ──────────────────────────────────────
# Optional secondary Ollama. Used automatically when the primary is
# unreachable, returns 5xx, or stalls past OLLAMA_PRIMARY_TIMEOUT_SECONDS.
# Backup is treated as a degraded experience: Leo probes primary again
# after OLLAMA_FALLBACK_STICKY_SECONDS and switches back on first success.
# Leave empty to disable fallback entirely.
OLLAMA_BACKUP_BASE_URL=""
OLLAMA_BACKUP_MODEL_NAME=""
# Defaults to OLLAMA_BACKUP_MODEL_NAME if unset.
OLLAMA_BACKUP_VISION_MODEL_NAME=""

# Cancel a primary call and retry on backup if it exceeds this many seconds.
OLLAMA_PRIMARY_TIMEOUT_SECONDS="120"

# Minimum time to remain on backup before probing primary again. After this
# window, the next call attempts primary; on failure the window restarts.
OLLAMA_FALLBACK_STICKY_SECONDS="300"


# ── Agent runtime ──────────────────────────────────────────────────────────
# Default timezone for reminders, briefings and the clock Leo reports.
# Individual users override it with `#tz Europe/London`.
DEFAULT_TZ="America/Los_Angeles"

# LRU cap on cached per-chat agents.
MAX_AGENTS="20"

# How long an idle per-chat agent (and its session) is kept before eviction.
TTL_SECONDS="1800"

# Rolling window of conversation items kept per chat. History is persisted to
# store/sessions.db, so it survives restarts; this bounds how much of it is
# replayed to the model. 0 keeps everything (may overflow the context window).
MAX_SESSION_ITEMS="40"

# Override where conversation history is stored.
# SESSIONS_DB_PATH=/home/PATH/store/sessions.db

# Show a "typing…" indicator in the chat while a run is in flight, so a slow
# local model looks intentional rather than broken.
PRESENCE_ENABLED=true

# How often the indicator is refreshed (WhatsApp drops it after ~10s).
PRESENCE_REFRESH_SECONDS="8"


# People send a thought as several rapid messages. Leo waits this long and
# answers the whole thought at once. 0 disables merging.
DEBOUNCE_SECONDS="2.5"
MAX_BURST_MESSAGES="10"

# Split replies longer than this across several WhatsApp messages.
MAX_REPLY_CHARS="3500"

# Extra directory Leo is allowed to send files from (its own store is always
# allowed). Anything outside these is refused.
# SHARE_DIR=/home/PATH/leo-outbox
MAX_SEND_BYTES="67108864"

# Reply to voice notes with a voice note. TTS_COMMAND receives the text on
# stdin and must write audio to {out}, e.g.
# TTS_COMMAND="piper --model en_US-amy-medium.onnx --output_file {out}"
VOICE_REPLIES=false
TTS_COMMAND=""


# ── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# Uncomment for a rotated file log in addition to stdout/journald.
# LOG_FILE=/home/PATH/whatsapp-leo.log
LOG_MAX_BYTES="10485760"
LOG_BACKUP_COUNT="5"


# ── Access control ─────────────────────────────────────────────────────────
# Comma-separated phone numbers (no +) allowed to use privileged tools
# (Workspace, Garmin, X, Playwright). Non-allowed senders only get
# unprivileged tools (e.g. Brave search).
ALLOWED_SENDERS=123

# The @mention string Leo listens for in group chats (ignored when
# IS_DEDICATED_NUMBER=true).
LEO_MENTION_ID=@234


# ── Security ───────────────────────────────────────────────────────────────
# Refuse write-capable tool calls (calendar create/update/delete, Gmail drafts,
# and the acting browser tools — click, type, fill_form, evaluate, run_code,
# file_upload) until the user explicitly confirms in a reply. Guards against
# prompt injection arriving via quoted messages, transcripts, web results, or
# the text of any page Leo opens. Costs one extra round-trip per write.
#
# Strongly recommended when PLAYWRIGHT_ENABLED=true: browsing feeds attacker-
# controlled text into an agent that can run JavaScript in a logged-in browser.
REQUIRE_WRITE_CONFIRMATION=false

# ── Third-party API keys ───────────────────────────────────────────────────
OPENAI_API_KEY=xxx
BRAVE_API_KEY=xxx


# ── Reminders ──────────────────────────────────────────────────────────────
# How often (seconds) the reminder loop checks the store for due reminders.
REMINDER_POLL_INTERVAL="60"


# ── Claude Code hooks ──────────────────────────────────────────────────────
IS_HOOK_ENABLED=true
# Comma-separated list of hook flavors to enable.
HOOKS="claude,claude-session"


# ── MCP servers ────────────────────────────────────────────────────────────
# Path to the bundled Google Workspace MCP server entrypoint.
# https://github.com/gemini-cli-extensions/workspace/releases/tag/v0.0.5
WORKSPACE_MCP_PATH="/home/PATH/dist/index.js"

# Playwright MCP — Chrome browsing. Lets Leo open real pages, not just read
# Brave search snippets. Needs npx and a Chrome/Chromium binary on PATH
# (install Google Chrome, or run `npx playwright install chromium` and set
# PLAYWRIGHT_BROWSER=chromium). Privileged senders only.
# Read the REQUIRE_WRITE_CONFIRMATION note above before enabling this.
PLAYWRIGHT_ENABLED=false

# Optional Playwright tuning; the defaults suit a headless server.
# PLAYWRIGHT_BROWSER=chrome           # chrome | chromium | msedge | firefox | webkit
# PLAYWRIGHT_HEADLESS=true            # false only where a display (or Xvfb) exists
# PLAYWRIGHT_NO_SANDBOX=true          # false where Chrome's own sandbox works;
#                                     # recent kernels block it under systemd user units
# PLAYWRIGHT_USER_DATA_DIR=~/.cache/whatsapp-leo/playwright-profile
# PLAYWRIGHT_VIEWPORT=1280x800
#
# The profile starts logged out, so Leo only reaches public pages. To let it
# read authenticated ones, sign that profile in once by hand — stop the agent
# first, since Chrome locks the directory to a single process:
#
#   systemctl --user stop whatsapp-leo-agent      # or kill start_services.sh
#   npx @playwright/mcp@0.0.70 --browser chrome \
#     --user-data-dir ~/.cache/whatsapp-leo/playwright-profile
#
# That command needs a display. On a headless box, `ssh -X` in from a desktop
# (needs xauth server-side), use the physical console, or run it under
# Xvfb + x11vnc. Sign in to the sites you want, quit, restart the agent.
# Keep this profile dedicated to Leo: anything it is logged into is something
# a page that successfully injects Leo can act on.

# Garmin MCP — setup.sh installs it with `uv tool install` so startup doesn't
# depend on GitHub. Override the binary, or the commit used when falling back
# to uvx, here.
# GARMIN_MCP_COMMAND=/home/PATH/.local/bin/garmin-mcp
# GARMIN_MCP_REF=a16f05770291fd25e35c58db17f9e77e70facbc2

# X (Twitter) MCP — run `uv run python x-mcp/x-mcp-server/setup.py` once
# to authenticate; cookies are persisted at this path.
X_COOKIE_PATH="/tmp/x_cookies.json"
